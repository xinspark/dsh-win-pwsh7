{
  "name": "dsh-win-pwsh7",
  "version": "0.2.2",
  "type": "module",
  "description": "Detect and validate PowerShell 7 for the Harness pwsh tool on Windows, and install it on request through the Microsoft Store — scripted or manual — while the pwsh tool stays blocked until a PowerShell 7 runtime actually resolves.",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.2.2-0"
  },
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinspark/dsh-win-pwsh7.git"
  },
  "homepage": "https://github.com/XinSpark/dsh-win-pwsh7#readme",
  "bugs": {
    "url": "https://github.com/XinSpark/dsh-win-pwsh7/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/typert.host.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "tools/"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "powershell",
    "pwsh",
    "windows"
  ],
  "scripts": {
    "check": "node tools/check-host.mjs && node tools/check-client.mjs && node tools/check-native-contracts.mjs",
    "check:contracts": "node tools/check-native-contracts.mjs",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "verifiedAgainst": "0.2.1-rc.3",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
